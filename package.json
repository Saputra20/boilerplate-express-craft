{
  "name": "boilerplate-express-craft",
  "version": "1.0.0",
  "description": "Express REST API boilerplate running on Bun",
  "main": "src/index.js",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0",
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.js",
    "start": "bun src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.js",
    "prettier:fix": "prettier --write **/*.js",
    "migrate": "bunx --bun sequelize-cli db:migrate",
    "migration:create": "bunx --bun sequelize-cli migration:create --underscored",
    "model:create": "bunx --bun sequelize-cli model:create --underscored",
    "seed:create": "bunx --bun sequelize-cli seed:generate",
    "seed": "bunx --bun sequelize-cli db:seed:all",
    "generate:key": "cd ./src/config/secret;openssl ecparam -name prime256v1 -genkey -noout -out private_key.pem; openssl ec -in private_key.pem -pubout -out public_key.pem",
    "prepare": "husky",
    "test": "bun test",
    "test:e2e": "bun test"
  },
  "author": "Saputra Nugraha",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "aws-sdk": "^2.1693.0",
    "basic-auth": "^3.0.0",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.1.2",
    "morgan": "^1.12.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
